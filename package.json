{
  "name": "vttg-system-dnd5e-2014",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Игровая система D&D 5e (редакция 2014) для VTTG — собирается ВНЕ приложения, доставка по ссылке на манифест",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "type-check": "npm run type-check:engine && npm run type-check:client",
    "type-check:engine": "vue-tsc --noEmit -p tsconfig.json",
    "type-check:client": "vue-tsc --noEmit -p tsconfig.client.json"
  },
  "devDependencies": {
    "@nuxt/ui": "4.5.1",
    "@vitejs/plugin-vue": "6.0.4",
    "esbuild": "0.25.12",
    "pinia": "3.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vue": "3.5.29",
    "vue-tsc": "3.3.5",
    "zod": "^3.25.76"
  }
}
