{
  // Строгая половина проверки: движок правил, сервер и нейтральное ядро.
  //
  // Здесь типы настоящие от начала до конца — ни одного модуля хоста, ни одной
  // заглушки, — поэтому включён весь `strict`, включая `noImplicitAny`. Именно
  // сюда приезжает переработка правил 2014, и эта половина обязана быть зелёной.
  "extends": "./tsconfig.base.json",
  "include": ["sdk/**/*.ts", "src/engine/**/*.ts", "src/server/**/*.ts"]
}
